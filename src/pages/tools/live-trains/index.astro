---
import StationSearch from '$lib/forms/StationSearch.astro';
import Breadcrumbs from '$lib/Breadcrumbs.astro';
import Global from '$layouts/Global.astro';
import { actions } from 'astro:actions';

const result = Astro.getActionResult(actions.stationSearch);

if (result) {
	if (result.error || !result.data) {
		return Astro.redirect(
			`?error=${result.error || 'search-missing-station'}`,
		);
	}

	if (!Array.isArray(result.data.matches)) {
		return Astro.redirect(`/tools/live-trains/${result.data.matches.crs}`);
	}
}
---

<Global>
	<Breadcrumbs />
	<h3>Live Train Times</h3>
	<StationSearch />
</Global>
