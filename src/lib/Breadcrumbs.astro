---
interface Section {
	title: string;
	link: string;
}

const OVERRIDES: Record<string, string> = {
	'live-trains': 'Live Train Times',
};

const CRS_PRE_SEGS = ['live-trains'];

function titleCase(str: string) {
	return str
		.split(' ')
		.map((segment) => {
			return `${segment.charAt(0).toUpperCase()}${segment.slice(1)}`;
		})
		.join(' ');
}

const sections: Section[] = Astro.url.pathname
	.split('/')
	.filter((segment) => segment.length > 0)
	.map((segment, index, sections): Section => {
		let title = OVERRIDES[segment] || null;

		if (!title && CRS_PRE_SEGS.includes(sections[index - 1]!)) {
			title = segment.toUpperCase();
		}

		title ??= titleCase(segment);

		return {
			title,
			link: `/${sections.slice(0, index + 1).join('/')}`,
		};
	});
---

<div class="breadcrumbs">
	{sections.map(({ title, link }) => <a href={link}>{title}</a>)}
</div>

<style>
	.breadcrumbs {
		a:not(:first-child) {
			position: relative;
			margin-left: 22px;

			&:before {
				content: '>';
				display: block;

				position: absolute;
				top: 50%;
				left: -14px;
				transform: translateY(-50%);

				color: var(--text);
			}
		}
	}
</style>
